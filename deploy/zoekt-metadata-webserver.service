[Unit]
Description=Zoekt documentation backend for the Formalization Corpus
After=network.target

[Service]
Type=simple
User=zack
Group=zack
ExecStart=/home/zack/lean-corpus/bin/zoekt-webserver.stock \
    -index /home/zack/lean-corpus/metadata-index \
    -listen 127.0.0.1:6072 \
    -html=false \
    -rpc
Restart=on-failure
RestartSec=5

MemoryMax=256M
MemoryHigh=192M

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/zack/lean-corpus

[Install]
WantedBy=multi-user.target
