[Unit]
Description=Zoekt documentation backend for the Formalization Corpus (user service)
After=network.target

[Service]
Type=simple
ExecStart=/home/zack/lean-corpus/bin/zoekt-webserver.stock \
    -index /home/zack/lean-corpus/metadata-index \
    -listen 127.0.0.1:6072 \
    -html=false \
    -rpc
Restart=on-failure
RestartSec=5
MemoryHigh=192M
MemoryMax=256M

[Install]
WantedBy=default.target
